--==================================================
-- TARGET
--==================================================

local function GetTarget()
    local center = Camera.ViewportSize / 2
    local closest
    local closestDistance = Settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then

            if Settings.TeamCheck and player.Team == LP.Team then
                continue
            end

            local char = player.Character
            if not char then
                continue
            end

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local part = char:FindFirstChild(Settings.TargetPart)

            if humanoid and humanoid.Health > 0 and part then
                local screenPos, visible =
                    Camera:WorldToViewportPoint(part.Position)

                if visible and screenPos.Z > 0 then
                    local distance = (
                        Vector2.new(screenPos.X, screenPos.Y)
                        - Vector2.new(center.X, center.Y)
                    ).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closest = part
                    end
                end
            end
        end
    end

    return closest
end

--==================================================
-- AIM ENGINE
--==================================================

local function AimAt(part)
    if not part then
        return
    end

    local cameraPosition = Camera.CFrame.Position

    local desired = CFrame.lookAt(
        cameraPosition,
        part.Position
    )

    if Settings.Flick then
        -- movimento rápido em direção ao alvo
        Camera.CFrame = Camera.CFrame:Lerp(
            desired,
            math.clamp(Settings.Smoothness * 3, 0.05, 1)
        )
    else
        -- mira suave
        Camera.CFrame = Camera.CFrame:Lerp(
            desired,
            math.clamp(Settings.Smoothness, 0.01, 1)
        )
    end
end

